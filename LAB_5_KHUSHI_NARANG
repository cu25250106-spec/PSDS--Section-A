class Stack:
    def __init__(self):
        self.stack = []

    def push(self, x):
        self.stack.append(x)

    def pop(self):
        return self.stack.pop()

    def peek(self):
        return self.stack[-1] if self.stack else None

    def empty(self):
        return len(self.stack) == 0


def priority(op):
    if op == '+' or op == '-':
        return 1
    if op == '*' or op == '/':
        return 2
    if op == '^':
        return 3
    return 0


def infix_to_postfix(exp):
    s = Stack()
    result = ""

    for ch in exp:
        if ch.isalnum():
            result += ch

        elif ch == '(':
            s.push(ch)

        elif ch == ')':
            while not s.empty() and s.peek() != '(':
                result += s.pop()
            if not s.empty():
                s.pop()

        else:
            while (not s.empty() and s.peek() != '('
                   and priority(s.peek()) >= priority(ch)):
                result += s.pop()
            s.push(ch)

    while not s.empty():
        result += s.pop()

    return result


exp = input("Enter infix expression: ")
print("Postfix expression:", infix_to_postfix(exp))

