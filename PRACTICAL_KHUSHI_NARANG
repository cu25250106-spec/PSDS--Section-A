
T = int(input())

for _ in range(T):
    S = input().strip()
    count = {}

    for ch in S:
        count[ch] = count.get(ch, 0) + 1

    pairs = 0
    odd = 0

    for freq in count.values():
        pairs += freq // 2
        if freq % 2 == 1:
            odd += 1

    ans = pairs
    print(ans)
